generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String?
  avatarUrl           String?
  role                Role                 @default(USER)
  xp                  Int                  @default(0)
  level               Int                  @default(1)
  dailyStreak         Int                  @default(0)
  lastStudyDate       DateTime?
  totalQuestions      Int                  @default(0)
  correctAnswers      Int                  @default(0)
  isActive            Boolean              @default(true)
  emailVerified       Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  dailyQuestionUsage  DailyQuestionUsage[]
  favorites           Favorite[]
  friendshipsAsA      Friendship[]         @relation("UserA")
  friendshipsAsB      Friendship[]         @relation("UserB")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  rankingEntries      RankingEntry[]
  refreshTokens       RefreshToken[]
  studySessions       StudySession[]
  subscription        Subscription?
  testAttempts        TestAttempt[]
  userAchievements    UserAchievement[]
  userAnswers         UserAnswer[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Opposition {
  id          String     @id @default(uuid())
  name        String
  code        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
  rankings    Ranking[]
  syllabi     Syllabus[]
  topics      Topic[]

  @@map("oppositions")
}

model Syllabus {
  id           String     @id @default(uuid())
  oppositionId String
  name         String
  year         Int?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  opposition   Opposition @relation(fields: [oppositionId], references: [id])
  topics       Topic[]

  @@map("syllabi")
}

model Law {
  id          String     @id @default(uuid())
  name        String
  shortName   String?
  code        String?
  description String?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  articles    Article[]
  questions   Question[]
  titles      Title[]

  @@map("laws")
}

model Title {
  id       String    @id @default(uuid())
  lawId    String
  number   String
  name     String
  order    Int       @default(0)
  articles Article[]
  chapters Chapter[]
  law      Law       @relation(fields: [lawId], references: [id])

  @@map("titles")
}

model Chapter {
  id       String    @id @default(uuid())
  titleId  String
  number   String
  name     String
  order    Int       @default(0)
  articles Article[]
  title    Title     @relation(fields: [titleId], references: [id])
  sections Section[]

  @@map("chapters")
}

model Section {
  id        String    @id @default(uuid())
  chapterId String
  number    String
  name      String
  order     Int       @default(0)
  articles  Article[]
  chapter   Chapter   @relation(fields: [chapterId], references: [id])

  @@map("sections")
}

model Article {
  id         String      @id @default(uuid())
  lawId      String
  titleId    String?
  chapterId  String?
  sectionId  String?
  number     String
  name       String?
  content    String?
  order      Int         @default(0)
  chapter    Chapter?    @relation(fields: [chapterId], references: [id])
  law        Law         @relation(fields: [lawId], references: [id])
  section    Section?    @relation(fields: [sectionId], references: [id])
  title      Title?      @relation(fields: [titleId], references: [id])
  paragraphs Paragraph[]
  questions  Question[]

  @@unique([lawId, number])
  @@map("articles")
}

model Paragraph {
  id        String  @id @default(uuid())
  articleId String
  number    String?
  content   String
  order     Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id])

  @@map("paragraphs")
}

model Topic {
  id           String     @id @default(uuid())
  oppositionId String
  syllabusId   String?
  name         String
  code         String?
  description  String?
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  parentId     String?
  questions    Question[]
  opposition   Opposition @relation(fields: [oppositionId], references: [id])
  parent       Topic?     @relation("TopicHierarchy", fields: [parentId], references: [id])
  children     Topic[]    @relation("TopicHierarchy")
  syllabus     Syllabus?  @relation(fields: [syllabusId], references: [id])

  @@map("topics")
}

model Question {
  id             String         @id @default(uuid())
  oppositionId   String
  topicId        String?
  lawId          String?
  articleId      String?
  statement      String
  explanation    String?
  legalReference String?
  difficulty     Difficulty     @default(MEDIUM)
  status         QuestionStatus @default(DRAFT)
  level          Int            @default(1)
  isRealExam     Boolean        @default(false)
  timesAnswered  Int            @default(0)
  timesCorrect   Int            @default(0)
  averageTimeMs  Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  publishedAt    DateTime?
  answers        Answer[] 
  favorites      Favorite[]
  article        Article?       @relation(fields: [articleId], references: [id])
  law            Law?           @relation(fields: [lawId], references: [id])
  opposition     Opposition     @relation(fields: [oppositionId], references: [id])
  topic          Topic?         @relation(fields: [topicId], references: [id])
  testQuestions  TestQuestion[]
  userAnswers    UserAnswer[]

  @@map("questions")
}

model Answer {
  id          String   @id @default(uuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  order       Int      @default(0)
  explanation String?
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model Test {
  id             String         @id @default(uuid())
  name           String?
  type           TestType       @default(PRACTICE)
  totalQuestions Int
  timeLimitSec   Int?
  filters        Json?
  createdAt      DateTime       @default(now())
  attempts       TestAttempt[]
  testQuestions  TestQuestion[]

  @@map("tests")
}

model TestQuestion {
  id         String   @id @default(uuid())
  testId     String
  questionId String
  order      Int
  question   Question @relation(fields: [questionId], references: [id])
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@map("test_questions")
}

model TestAttempt {
  id              String       @id @default(uuid())
  userId          String
  testId          String
  status          TestStatus   @default(IN_PROGRESS)
  score           Float?
  correctCount    Int          @default(0)
  wrongCount      Int          @default(0)
  unansweredCount Int          @default(0)
  xpEarned        Int          @default(0)
  timeSpentSec    Int?
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  test            Test         @relation(fields: [testId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  userAnswers     UserAnswer[]

  @@map("test_attempts")
}

model UserAnswer {
  id               String       @id @default(uuid())
  userId           String
  questionId       String
  testAttemptId    String?
  selectedAnswerId String?
  isCorrect        Boolean
  timeSpentMs      Int?
  answeredAt       DateTime     @default(now())
  question         Question     @relation(fields: [questionId], references: [id])
  testAttempt      TestAttempt? @relation(fields: [testAttemptId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  @@map("user_answers")
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  description      String
  iconUrl          String?
  xpReward         Int               @default(0)
  condition        Json
  isActive         Boolean           @default(true)
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Ranking {
  id           String         @id @default(uuid())
  oppositionId String?
  name         String
  type         String
  periodStart  DateTime?
  periodEnd    DateTime?
  isActive     Boolean        @default(true)
  entries      RankingEntry[]
  opposition   Opposition?    @relation(fields: [oppositionId], references: [id])

  @@map("rankings")
}

model RankingEntry {
  id        String   @id @default(uuid())
  rankingId String
  userId    String
  score     Int
  position  Int?
  updatedAt DateTime @updatedAt
  ranking   Ranking  @relation(fields: [rankingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([rankingId, userId])
  @@map("ranking_entries")
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  userA     User     @relation("UserA", fields: [userAId], references: [id])
  userB     User     @relation("UserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
  @@map("friendships")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Subscription {
  id               String                @id @default(uuid())
  userId           String                @unique
  status           SubscriptionStatus    @default(FREE)
  plan             String                @default("FREE")
  startDate        DateTime?
  endDate          DateTime?
  stripeCustomerId String?
  stripeSubId      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  autoRenew        Boolean               @default(true)
  platform         SubscriptionPlatform?
  productId        String?
  user             User                  @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model DailyQuestionUsage {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime
  questionsUsed Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_question_usage")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, questionId])
  @@map("favorites")
}

model StudySession {
  id                String    @id @default(uuid())
  userId            String
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  questionsAnswered Int       @default(0)
  xpEarned          Int       @default(0)
  user              User      @relation(fields: [userId], references: [id])

  @@map("study_sessions")
}

enum Role {
  USER
  PREMIUM
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum SubscriptionPlatform {
  APPLE
  GOOGLE
}

enum QuestionStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum TestType {
  PRACTICE
  SIMULACRO
  FAILED_ONLY
  FAVORITES
  CUSTOM
  DAILY
  GLOBAL
  REAL
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}