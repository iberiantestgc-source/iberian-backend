# Database
DATABASE_URL="postgresql://user:password@localhost:5432/iberian?schema=public"

# JWT
JWT_SECRET="change-this-super-secret-key-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development

# Supabase (Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=iberian-files

# OpenAI
OPENAI_API_KEY=

# Stripe (Subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
